#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later

set -eu

attempt=0
until /usr/bin/vinyladm -T 127.0.0.1:6082 -S /etc/vinyl-cache/secret status >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 25 ]; then
    printf '%s\n' 'Vinyl management listener did not become ready' >&2
    exit 1
  fi
  sleep 0.2
done

name="stackfort_$(date +%s)"
/usr/bin/vinyladm -T 127.0.0.1:6082 -S /etc/vinyl-cache/secret \
  vcl.load "$name" /etc/vinyl-cache/stackfort.vcl
/usr/bin/vinyladm -T 127.0.0.1:6082 -S /etc/vinyl-cache/secret \
  vcl.use "$name"
