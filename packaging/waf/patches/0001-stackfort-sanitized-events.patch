     return dl_free_waf(w);
diff --git a/src/ngx_http_coraza_log.c b/src/ngx_http_coraza_log.c
index f4017a5..229f76d 100644
--- a/src/ngx_http_coraza_log.c
+++ b/src/ngx_http_coraza_log.c
@@ -13,6 +13,68 @@
 #include "ngx_http_coraza_common.h"
 
 
+ngx_http_request_t *ngx_http_coraza_active_request = NULL;
+
+
+static const char *
+ngx_http_coraza_severity_name(coraza_severity_t severity)
+{
+    switch (severity) {
+    case CORAZA_SEVERITY_EMERGENCY: return "EMERGENCY";
+    case CORAZA_SEVERITY_ALERT:     return "ALERT";
+    case CORAZA_SEVERITY_CRITICAL:  return "CRITICAL";
+    case CORAZA_SEVERITY_ERROR:     return "ERROR";
+    case CORAZA_SEVERITY_WARNING:   return "WARNING";
+    case CORAZA_SEVERITY_NOTICE:    return "NOTICE";
+    case CORAZA_SEVERITY_INFO:      return "INFO";
+    case CORAZA_SEVERITY_DEBUG:     return "DEBUG";
+    default:                        return "UNKNOWN";
+    }
+}
+
+
+void
+ngx_http_coraza_error_callback(void *user_context, coraza_matched_rule_t rule)
+{
+    ngx_http_request_t    *r;
+    ngx_http_coraza_ctx_t *ctx;
+    ngx_log_t             sanitized_log;
+    ngx_str_t              method;
+    ngx_str_t              path;
+    ngx_str_t              correlation = ngx_null_string;
+    int                    rule_id;
+
+    (void) user_context;
+    r = ngx_http_coraza_active_request;
+    if (r == NULL || r->connection == NULL) {
+        return;
+    }
+    rule_id = coraza_matched_rule_get_id(rule);
+    if (rule_id <= 0) {
+        return;
+    }
+    ctx = ngx_http_get_module_ctx(r, ngx_http_coraza_module);
+    if (ctx != NULL) {
+        correlation = ctx->transaction_id;
+        if (correlation.len > 128) correlation.len = 128;
+    }
+    method = r->method_name;
+    path = r->uri;
+    if (method.len > 32) method.len = 32;
+    if (path.len > 1024) path.len = 1024;
+    sanitized_log = *r->connection->log;
+    sanitized_log.handler = NULL;
+    sanitized_log.data = NULL;
+
+    ngx_log_error(NGX_LOG_WARN, &sanitized_log, 0,
+        "coraza: Stackfort event [id \"%i\"] [severity \"%s\"] "
+        "[unique_id \"%V\"] request: \"%V %V HTTP/1.1\"",
+        (ngx_int_t) rule_id,
+        ngx_http_coraza_severity_name(coraza_matched_rule_get_severity(rule)),
+        &correlation, &method, &path);
+}
+
+
 ngx_int_t
 ngx_http_coraza_log_handler(ngx_http_request_t *r)
 {
@@ -34,7 +86,9 @@ ngx_http_coraza_log_handler(ngx_http_request_t *r)
         return NGX_OK;
     }
 
+    ngx_http_coraza_active_request = r;
     coraza_process_logging(ctx->coraza_transaction);
+    ngx_http_coraza_active_request = NULL;
 
     return NGX_OK;
 }
