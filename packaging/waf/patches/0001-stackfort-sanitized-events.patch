+    DL_SYM(dl_add_error_callback,       coraza_add_error_callback);
+    DL_SYM(dl_matched_rule_get_id,      coraza_matched_rule_get_id);
+    DL_SYM(dl_matched_rule_get_severity, coraza_matched_rule_get_severity);
     DL_SYM(dl_free_waf,                 coraza_free_waf);
     DL_SYM(dl_rules_count,              coraza_rules_count);
     DL_SYM(dl_new_transaction,           coraza_new_transaction);
@@ -229,6 +238,24 @@ coraza_waf_t coraza_new_waf(coraza_waf_config_t config, char **err)
