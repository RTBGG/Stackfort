 src/ngx_http_coraza_rewrite.c       |  2 ++
 8 files changed, 100 insertions(+)

diff --git a/src/ngx_http_coraza_common.h b/src/ngx_http_coraza_common.h
index 849f34b..9c1f785 100644
--- a/src/ngx_http_coraza_common.h
+++ b/src/ngx_http_coraza_common.h
@@ -175,6 +175,11 @@ ngx_http_coraza_process_body_failed(int ret)
 
 extern ngx_module_t ngx_http_coraza_module;
 
+/* The nginx worker event loop is single-threaded. Rule-phase callers bind the
+ * active request only for the synchronous libcoraza call below. */
+extern ngx_http_request_t *ngx_http_coraza_active_request;
+void ngx_http_coraza_error_callback(void *user_context, coraza_matched_rule_t rule);
+
 /* ngx_http_coraza_module.c */
