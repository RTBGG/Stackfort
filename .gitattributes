# Normalize source and configuration files for Linux builds on every checkout.
* text=auto

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.controllers text eol=lf
*.vcl text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.sha256 text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.mjs text eol=lf
*.ps1 text eol=lf

# The qualified Coraza connector patch has a repository SHA-256 lock.
*.patch -text
