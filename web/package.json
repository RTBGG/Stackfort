{
  "name": "@stackfort/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "check:i18n": "node scripts/check-i18n-literals.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-i18n": "11.4.12"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-dom": "3.5.43",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
